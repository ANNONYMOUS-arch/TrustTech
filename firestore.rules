rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'admin');
    }

    function isVerifiedDeveloper() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerifiedDeveloper == true;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Prevent users from escalating role or changing balances
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'isVerifiedDeveloper', 'hasPremiumAccess'])
        || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Projects Collection
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid) || isAdmin();
    }

    // 3. Financial Transactions Collection (Immutable Ledger)
    match /financialTransactions/{txnId} {
      // Users can only read their own transactions (as client, developer, or counterparty)
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.counterpartyId == request.auth.uid || 
         isAdmin());
      // Financial records must only be created or modified by trusted backend
      allow create, update, delete: if isAdmin();
    }

    // 4. Developer Earnings Collection
    match /developerEarnings/{devUid} {
      // Developer can read their own earnings breakdown; Admin can read all
      allow read: if isOwner(devUid) || isAdmin();
      // Only backend updates balances
      allow write: if isAdmin();
    }

    // 5. Developer Payout Accounts Collection
    match /developerPayoutAccounts/{accountId} {
      // Developer can read their own payout accounts; Admin can read all
      allow read: if isAuthenticated() && (resource.data.developerUid == request.auth.uid || isAdmin());
      // Approved developers can add payout account; must be marked verified via backend
      allow create: if isAuthenticated() && request.resource.data.developerUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.developerUid == request.auth.uid && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'verifiedAt']) || isAdmin();
      allow delete: if isAuthenticated() && (resource.data.developerUid == request.auth.uid || isAdmin());
    }

    // 6. Payout Requests Collection
    match /payoutRequests/{payoutId} {
      // Developer can view their own payout requests; Admin can read all
      allow read: if isAuthenticated() && (resource.data.developerUid == request.auth.uid || isAdmin());
      // Developer can submit withdrawal request (backend validates sufficiency and idempotency)
      allow create: if isAuthenticated() && request.resource.data.developerUid == request.auth.uid;
      // Only admin or backend can update payout status (Processing -> Successful / Failed)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 7. Subscriptions Collection
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 8. Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (resource.data.billedTo.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 9. Refund Requests Collection
    match /refundRequests/{refundId} {
      allow read: if isAuthenticated() && 
        (resource.data.clientUid == request.auth.uid || 
         resource.data.developerUid == request.auth.uid || 
         isAdmin());
      allow create: if isAuthenticated() && request.resource.data.clientUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 10. Disputes Collection
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && 
        (resource.data.raisedByUid == request.auth.uid || 
         resource.data.defendantUid == request.auth.uid || 
         isAdmin());
      allow create: if isAuthenticated() && request.resource.data.raisedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 11. Financial Settings Collection
    match /financialSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
